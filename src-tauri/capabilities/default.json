{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DB Desk main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "process:allow-restart"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  }
}
