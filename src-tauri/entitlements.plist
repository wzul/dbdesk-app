<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The Python sidecar is a PyInstaller one-file binary: at launch it extracts
    its dylibs into a temporary directory and dlopen()s them. Hardened runtime
    (required for notarization) refuses to load libraries that are not signed by
    the same Team ID, so the app needs library validation disabled.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Some Python extensions map executable memory at runtime. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
